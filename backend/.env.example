# Copy to .env and fill in. Never commit .env.

# --- Alpaca API (get keys at https://alpaca.markets) ---
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# 'iex' for free accounts, 'sip' with a paid data plan
ALPACA_DATA_FEED=iex

# --- Flask ---
SECRET_KEY=change_me
LOG_LEVEL=INFO
POSTGRES_PASSWORD=trading_password

# --- What to scan ---
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA,AMD,META,NFLX,UBER
BAR_TIMEFRAME=5Min
# seconds between signal scans
SIGNAL_INTERVAL=300
# seconds between stop/target checks
CHECK_INTERVAL=60
CONFIDENCE_THRESHOLD=0.60
MIN_AGREEING_STRATEGIES=3
SIGNAL_COOLDOWN_MINUTES=30

# --- Stock scanner: let the bot pick today's most active stocks and movers ---
AUTO_SCAN=true
# also analyze the STOCK_SYMBOLS list above
SCAN_INCLUDE_WATCHLIST=true
SCAN_MAX_SYMBOLS=15
SCAN_MIN_PRICE=5
SCAN_MAX_PRICE=1000
# skip stocks already up or down more than this % today
SCAN_MAX_MOVE_PCT=25
SCAN_REFRESH_MINUTES=15

# --- Sharing the dashboard ---
# Leave empty: the controls only work on this computer; anyone opening a shared link can look but not touch.
# Set a long password (8+ characters) to be able to unlock the controls from a shared link yourself.
ADMIN_PASSWORD=

# --- Discord notifications (leave empty to turn off) ---
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
# Treat this link like a password: anyone who has it can post to your channel.
DISCORD_WEBHOOK_URL=
NOTIFY_SIGNALS=true
NOTIFY_TRADES=true

# --- Automated trading (off by default) ---
# let the bot open trades on its own
AUTO_TRADE=false
# 'simulated' (local paper ledger) or 'alpaca' (send orders to Alpaca)
EXECUTION_MODE=simulated
# must be true to send orders to a non-paper Alpaca URL
ALLOW_LIVE_TRADING=false
ALLOW_SHORTING=false

# --- Risk management ---
# equity for simulated mode and backtests
STARTING_CAPITAL=100000
# % of equity lost if the stop is hit
RISK_PER_TRADE_PCT=1.0
# max % of equity in one position
MAX_POSITION_PCT=10.0
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
MAX_OPEN_POSITIONS=5
# stop opening trades after this daily loss
MAX_DAILY_LOSS_PCT=3.0
# close all positions before the bell
FLATTEN_AT_CLOSE=true
FLATTEN_MINUTES_BEFORE_CLOSE=10

# --- Machine learning ---
USE_ML_ADJUSTMENT=true
RETRAIN_INTERVAL_HOURS=24
# true = install TensorFlow in the Docker image
INSTALL_ML=false

# Local (non-Docker) runs default to SQLite; set this to use Postgres instead
# DATABASE_URL=postgresql://trading_user:trading_password@localhost:5432/day_trading_bot
