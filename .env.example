# Copy to .env and fill in. Never commit .env.

# --- Alpaca API (get keys at https://alpaca.markets) ---
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# 'iex' for free accounts, 'sip' with a paid data plan
ALPACA_DATA_FEED=iex

# --- Flask ---
SECRET_KEY=change_me
LOG_LEVEL=INFO
POSTGRES_PASSWORD=trading_password

# --- What to scan ---
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA,AMD,META,NFLX,UBER
BAR_TIMEFRAME=5Min
# seconds between signal scans
SIGNAL_INTERVAL=300
# seconds between stop/target checks
CHECK_INTERVAL=60
CONFIDENCE_THRESHOLD=0.60
MIN_AGREEING_STRATEGIES=3
SIGNAL_COOLDOWN_MINUTES=30

# --- Automated trading (off by default) ---
# let the bot open trades on its own
AUTO_TRADE=false
# 'simulated' (local paper ledger) or 'alpaca' (send orders to Alpaca)
EXECUTION_MODE=simulated
# must be true to send orders to a non-paper Alpaca URL
ALLOW_LIVE_TRADING=false
ALLOW_SHORTING=false

# --- Risk management ---
# equity for simulated mode and backtests
STARTING_CAPITAL=100000
# % of equity lost if the stop is hit
RISK_PER_TRADE_PCT=1.0
# max % of equity in one position
MAX_POSITION_PCT=10.0
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
MAX_OPEN_POSITIONS=5
# stop opening trades after this daily loss
MAX_DAILY_LOSS_PCT=3.0
# close all positions before the bell
FLATTEN_AT_CLOSE=true
FLATTEN_MINUTES_BEFORE_CLOSE=10

# --- Machine learning ---
USE_ML_ADJUSTMENT=true
RETRAIN_INTERVAL_HOURS=24
# true = install TensorFlow in the Docker image
INSTALL_ML=false
